# ═══════════════════════════════════════════════════════════════
# ETIP v4.0 — Frontend Dockerfile
# Multi-stage: install → build Vite → serve via nginx
# ═══════════════════════════════════════════════════════════════

# ── Stage 1: Install + Build ───────────────────────────────────
# RULE: NEVER use Alpine for Node build stages (DEPLOYMENT_RCA Issue #7)
FROM node:20-slim AS build
ARG VITE_TURNSTILE_SITE_KEY=""
ENV VITE_TURNSTILE_SITE_KEY=${VITE_TURNSTILE_SITE_KEY}
RUN corepack enable && corepack prepare pnpm@9.15.0 --activate
WORKDIR /app

# Copy workspace manifests (root + workspaces that frontend depends on)
# packages/shared-ui MUST be listed here — vite.config.ts has a path alias:
#   '@etip/shared-ui' → '../../packages/shared-ui/src'
# Without copying this package first, the Vite build fails to resolve the alias.
# tsconfig.base.json required: shared-ui/tsconfig.json extends ../../tsconfig.base.json
COPY package.json pnpm-workspace.yaml pnpm-lock.yaml tsconfig.base.json ./
COPY apps/frontend/package.json     apps/frontend/
COPY packages/shared-ui/package.json packages/shared-ui/

# RULE: strict --frozen-lockfile, NO fallback. Stale lockfile = build MUST fail. (Issues #11, #16)
# Cache mount: persists pnpm store across builds so unchanged packages aren't re-downloaded.
RUN --mount=type=cache,target=/root/.local/share/pnpm/store \
    pnpm install --frozen-lockfile

# Copy sources — frontend + shared-ui (required by vite alias at build time)
COPY apps/frontend/   apps/frontend/
COPY packages/shared-ui/ packages/shared-ui/

# Build: skip tsc type-check in Docker (CI handles it), run Vite only.
# Then prerender public routes (SEO plan 2.1): SSR bundle → static HTML per route in dist/.
# No headless browser — React renderToPipeableStream, so the node:20-slim stage stays lean.
RUN cd apps/frontend && npx vite build \
    && npx vite build --ssr src/entry-server.tsx --outDir dist-ssr \
    && node --test scripts/ \
    && node scripts/prerender.mjs

# ── Stage 2: Serve via nginx ──────────────────────────────────
FROM nginx:1.27-alpine AS production

# Remove default nginx content
RUN rm -rf /usr/share/nginx/html/*

# Copy built assets
COPY --from=build /app/apps/frontend/dist /usr/share/nginx/html

# SPA routing, true 404s, noindex on private routes — see apps/frontend/nginx.conf
COPY apps/frontend/nginx.conf /etc/nginx/conf.d/default.conf

EXPOSE 80

# curl is not available in nginx:alpine — use wget via sh or just check port open
HEALTHCHECK --interval=30s --timeout=5s --retries=3 \
  CMD sh -c 'printf "GET / HTTP/1.0\r\nHost: localhost\r\n\r\n" | nc -w2 localhost 80 | head -1 | grep -q "HTTP"'
